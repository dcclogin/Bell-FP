cabal-version: 3.0

name:           bell-fp-paper
version:        0.1.0.0
synopsis:       The data of bell-fp.tex
description:
  Runs every model of the paper through the package bell-fp
  and writes the numbers, tables and printed reports that the paper
  quotes. It also runs the separate no-signalling check of the
  submission (Separate.hs), for the comparison in Section 8, and checks
  the paper's own examples (Examples.hs).
build-type:     Simple
license:        BSD-3-Clause

executable bell-fp-paper-data
  main-is:          PaperData.hs
  other-modules:    Check
                    Examples
                    Explored
                    PureBoxes
                    Separate
  hs-source-dirs:   .
  default-language: Haskell2010
  default-extensions:
      RankNTypes
  ghc-options:      -Wall -Wcompat
  build-depends:
      base >=4.14 && <5
    , directory
    , filepath
    , mtl
    , bell-fp
