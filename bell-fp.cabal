cabal-version: 3.0

name:           bell-fp
version:        0.1.0.0
synopsis:       The Bell experiment, monadically: quantum boxes as state vectors
description:
  An executable model of the two-party Bell (CHSH) experiment, written
  to accompany the paper "The Bell Experiment, Monadically". The boxes
  of the two parties compute in one monad, the experiment in another,
  and both verdicts of a run, the CHSH value and whether the boxes
  signal, are read off the table of that run. Models: pure boxes, a
  shared location, clocked boxes, local hidden variables, superdeterminism,
  quantum boxes (state vectors and the Born rule), PR boxes, and hidden
  states that the boxes rewrite.
build-type:     Simple
license:        BSD-3-Clause

common shared
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat

library
  import: shared
  exposed-modules:
      CHSH.Util
      CHSH.Experiment
      CHSH.NoSignaling
      CHSH.Explore
      CHSH.Identity
      CHSH.LHV
      CHSH.Shared
      CHSH.Clocked
      CHSH.Superdet
      CHSH.Quantum
      CHSH.PR
      CHSH.PRState
      CHSH.BellTable
      CHSH.Contextuality
  hs-source-dirs:
      src
  default-extensions:
      GeneralizedNewtypeDeriving
      RankNTypes
      FlexibleInstances
      FlexibleContexts
      DerivingStrategies
  build-depends:
      base >=4.14 && <5
    , mtl
    , random

executable bell-fp
  import: shared
  main-is: Main.hs
  hs-source-dirs:
      app
  default-extensions:
      RankNTypes
  build-depends:
      base >=4.14 && <5
    , bell-fp

-- the earlier sampler and trial code (demo/Old.hs), verbatim, against this library's
executable bell-fp-compare
  import: shared
  main-is: Compare.hs
  other-modules:
      Old
  hs-source-dirs:
      demo
  default-extensions:
      RankNTypes
  build-depends:
      base >=4.14 && <5
    , filepath
    , mtl
    , random
    , bell-fp

test-suite bell-fp-test
  import: shared
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Old
  hs-source-dirs:
      test
      demo
  default-extensions:
      RankNTypes
  build-depends:
      base >=4.14 && <5
    , mtl
    , random
    , bell-fp
    , HUnit
